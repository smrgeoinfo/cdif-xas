@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema: <http://schema.org/> .
@prefix xas: <https://w3id.org/cdif/xas/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif: <https://w3id.org/cdif/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix doi: <https://doi.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://example.org/> .

<#TriplesMap_root> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rml:class schema:Dataset;
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['@id']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "http://localhost:8080/citation?persistentId=perma:" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "https://example.org/dataset/" ]
        ]
      ]
    ];
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['schema:name']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:description;
    rr:objectMap [
      rml:reference "$['schema:description']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:url;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:contentUrl']['@id']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:sameAs;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:description']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:license;
    rr:objectMap [
      rml:reference "$['schema:license']['@id']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:version;
    rr:objectMap [
      rml:reference "$['schema:version']"
    ]
  ] ;
  # NOTE: the bare-string schema:keywords passthrough from
  # $['schema:keywords'] was removed because xasCore requires each
  # keyword to be a schema:DefinedTerm object; string literals like
  # "Earth and Environmental Sciences" fail validation. If a use case
  # needs those preserved, wrap them into DefinedTerm objects via an
  # FnO transform (build {@type: schema:DefinedTerm, schema:name: <str>})
  # rather than passing them through raw.
  rr:predicateObjectMap [
    rr:predicate schema:keywords;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_keywords_element_edge>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:keywords;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_keywords_element_symbol>
    ]
  ] ;
   rr:predicateObjectMap [ 
    rr:predicate  schema:identifier;
    rr:objectMap [ 
      rml:reference "$['schema:identifier']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:dateModified;
    rr:objectMap [ 
      rml:reference "$['schema:dateModified']['@value']"
    ]
  ] ;
   rr:predicateObjectMap [ 
    rr:predicate  schema:variableMeasured;
    rr:objectMap [ 
      rr:parentTriplesMap <#TriplesMap_variableMeasured>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:subjectOf;
    rr:objectMap [ 
      rr:parentTriplesMap <#TriplesMap_subjectOf>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	  rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_role_facility>
    ]
  ]  ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_author_role>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_creator_role>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:measurementTechnique;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_panet>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:measurementTechnique;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_nexus>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  prov:wasGeneratedBy;
    rr:objectMap [
      rr:constant <https://w3id.org/cdif/xas/provevent>;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:distribution;
	  rr:objectMap [
	    rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ]
  ] .
  
<#TriplesMap_variableMeasured> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['columns'][*]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ] ;
  rml:subjectMap [
    rml:class schema:PropertyValue, cdi:InstanceVariable ;
    rml:reference "$['ivIRI']" ;
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name ;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/ .*$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:alternateName;
     rr:objectMap [
      rml:reference "$['meaning']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:description;
     rr:objectMap [
      rml:reference "$['meaning']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:uses;
     rr:objectMap [
      rml:reference "$['rvIRI']"
    ]
  ] ;
  # NOTE: cdif:physicalDataType emission was removed. It was there to
  # clear a SHACL info/warning ('should specify cdif:physicalDataType')
  # but pyld framing wraps rr:constant strings inconsistently into
  # arrays like ["decimal"] for some columns, which then fails the
  # cdifConceptOrTermOrString anyOf (string/DefinedTerm/Concept, but
  # not array-of-string). Losing the info-level SHACL recommendation
  # is a better trade than emitting hard JSON Schema errors. To restore
  # once the frame emits scalar-shaped values reliably, add:
  #   rr:predicateObjectMap [
  #     rr:predicate cdif:physicalDataType;
  #     rr:objectMap [ rr:constant "decimal" ]
  #   ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      a fnml:FunctionTermMap;
      # Prepends the full XAS glossary base and marks the result as an
      # IRI reference so it serializes as JSON-LD {"@id": "..."} instead
      # of a bare string literal. Note: $['meaning'] values that carry
      # spaces or mixed case will produce non-resolving IRIs; the v2
      # glossary uses lowercase, no-underscore local names (see
      # https://w3id.org/cdif/xas/). Consider normalizing $['meaning']
      # upstream (in api/cdif.py's column build) so it lands here as a
      # v2-conformant local name.
      rr:termType rr:IRI ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['meaning']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "https://w3id.org/cdif/xas/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:unitText ;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:controls_if ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:bool_b;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_contains ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['definition']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:string_sub;
                rr:objectMap [ rr:constant " " ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:any_true;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_replace ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['definition']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_find;
                rr:objectMap [ rr:constant "/^.* /" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_replace;
                rr:objectMap [ rr:constant "" ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:any_false;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] .

  
<#TriplesMap_subjectOf> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ] ;
  rml:subjectMap [
      rml:class schema:Dataset;
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_replace ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['@id']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_find;
                rr:objectMap [ rr:constant "http://localhost:8080/citation?persistentId=perma:" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_replace;
                rr:objectMap [ rr:constant "https://example.org/dataset/" ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "/metadata" ]
        ]
      ]
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant dcat:CatalogRecord ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/core/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/discovery/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/data_description/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/data_structure/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/xasCore/1.0> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/xasOptional/1.0> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:about;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_root>;
      rr:joinCondition [
        rr:child "$['@id']";
        rr:parent "$['@id']"
      ]
    ]
  ] .
 

<#TriplesMap_role_facility> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Facility')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Role;
      rml:template "_:role_facility"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:roleName;
    rr:objectMap [
      rr:constant "Facility"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:contributor;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_role_facility_name>
    ]
  ] .

<#TriplesMap_role_facility_name> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Facility')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Organization;
      rml:template "_:role_facility_name"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['cdi:Facility_name']['skos:definition']"
    ]
  ] .

<#TriplesMap_keywords_element_edge> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Element')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rml:template "_:keywords_element_edge"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:termCode;
    rr:objectMap [
      rml:reference "$['cdi:Element_edge']['skos:definition']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:inDefinedTermSet;
    rr:objectMap [
      rr:constant "https://github.com/XraySpectroscopy/XAS-Data-Interchange/blob/master/specification/dictionary.md"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Element_edge']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "-edge" ]
        ]
      ]
    ]
  ] ;
  # Glossary tooling marker so downstream consumers can distinguish the
  # edge-slot keyword from the element-symbol keyword.
  rr:predicateObjectMap [
    rr:predicate schema:about;
    rr:objectMap [ rr:constant "element.edge" ]
  ] .

<#TriplesMap_keywords_element_symbol> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Element')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rml:template "_:keywords_element_symbol"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:termCode;
    rr:objectMap [
      rml:reference "$['cdi:Element_symbol']['skos:definition']"
    ]
  ] ;
  # schema:name is required on the DefinedTerm. Prefer Element.name if
  # the XDI carries it, otherwise fall back to a "Element symbol X"
  # form so the name field is always emitted (bare symbols like "Se"
  # would fail xasCore's minLength when applied).
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Element_symbol']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "Element symbol " ]
        ]
      ]
    ]
  ] ;
  # SWEET matrElement identifier built from the symbol (e.g. Se ->
  # http://sweetontology.net/matrElement/Se). Downstream consumers can
  # dereference the identifier for authoritative element metadata.
  rr:predicateObjectMap [
    rr:predicate schema:identifier;
    rr:objectMap [
      a fnml:FunctionTermMap;
      rr:termType rr:IRI;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Element_symbol']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "http://sweetontology.net/matrElement/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:inDefinedTermSet;
    rr:objectMap [
      rr:constant "http://sweetontology.net/matrElement"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:about;
    rr:objectMap [ rr:constant "element.symbol" ]
  ] .

<#TriplesMap_dv_author_role> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Role;
      rml:template "_:role_author"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:roleName;
    rr:objectMap [
      rr:constant "Author"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:contributor;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_author_contributor>
    ]
  ] .

<#TriplesMap_dv_author_contributor> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Person;
      rml:template "_:role_author_name"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['schema:author']['schema:name']"
    ]
  ] .

<#TriplesMap_dv_creator_role> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Role;
      rr:template "_:role_creator"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:roleName;
    rr:objectMap [
      rr:constant "Creator"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:contributor;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_creator_contributor>
    ]
  ] .

<#TriplesMap_dv_creator_contributor> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Person;
      rml:template "_:role_creator_name"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['schema:author']['schema:name']"
    ]
  ] .

<#TriplesMap_panet> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rr:template "_:panet"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "X-Ray Absorption Spectroscopy"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:termCode;
    rr:objectMap [
      rr:constant "XAS"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:identifier;
    rr:objectMap [
      rr:constant "http://purl.org/pan-science/PaNET/PaNET01196"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:inDefinedTermSet;
    rr:objectMap [
      rr:constant "http://purl.org/pan-science/PaNET/PaNET.owl"
    ]
  ] .

<#TriplesMap_nexus> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rr:template "_:nexus"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "Transmission"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:inDefinedTermSet;
    rr:objectMap [
      rr:constant "nxs:Field/NXxas/ENTRY/DATA/mode"
    ]
  ] .

<#TriplesMap_scan_startdate> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Scan')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rml:class prov:Activity, schema:Action;
      rml:template "https://w3id.org/cdif/xas/provevent"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:startDate;
    rr:objectMap [
      rml:reference "$['skos:prefLabel'][2]"
    ]
  ] .

<#TriplesMap_scan> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Scan')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rml:class prov:Activity, schema:Action;
      rml:template "https://w3id.org/cdif/xas/provevent"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:analysisevent ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_scan_edge_energy>
    ]
  ] ;
  # xasCore requires a schema:object pointing at the material sample
  # analyzed by this activity.
  rr:predicateObjectMap [
    rr:predicate schema:object;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_sample>
    ]
  ] .

# MaterialSample block. Reads the sample name from the parsed XDI
# graph (Sample.name header lands as cdi:Sample_name with its value
# in skos:definition on a blank node under cdi:Sample). Emits the
# xasCore-required additionalType pair (free-label "MaterialSample"
# plus the iSample vocabulary URI as an @id reference).
<#TriplesMap_sample> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Sample')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Thing, schema:Product;
      rr:template "_:sample"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [ rr:constant "MaterialSample" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant <https://w3id.org/isample/vocabulary/materialsampleobjecttype/materialsample> ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['cdi:Sample_name']['skos:definition']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_sample_preparation>
    ]
  ] .

# Optional sample-preparation additionalProperty. Reads the XDI
# Sample.prep header (cdi:Sample_prep) when present. If the header
# is absent the rml:reference resolves to null and the RML engine
# suppresses the emission.
<#TriplesMap_sample_preparation> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Sample' && @['cdi:Sample_prep'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:sample_preparation"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:samplepreparation ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "Sample preparation" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Sample_prep']['skos:definition']"
    ]
  ] .

<#TriplesMap_scan_edge_energy> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Scan' && @['cdi:Scan_edge_energy'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:scan_edge_energy"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:edgeenergy ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "Edge energy" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Scan_edge_energy']['skos:definition']"
    ]
  ] .

<#TriplesMap_activity_used> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:class prov:Activity, schema:Action;
      rr:template "https://w3id.org/cdif/xas/provevent"
    ] ;
  # xasCore requires the activity to carry schema:additionalType
  # xas:analysisevent. Emitted here (on the always-firing
  # activity_used TriplesMap) rather than on TriplesMap_scan, which
  # depends on the XDI carrying Scan.* headers -- many dialects don't.
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:analysisevent ;
      rr:termType rr:IRI
    ]
  ] ;
  # Peer prov:used instrument model per xasCore: one prov:used wrapper
  # per instrument, each wrapper carrying a single schema:instrument.
  rr:predicateObjectMap [
    rr:predicate prov:used;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_prov_used_source> ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:used;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_prov_used_beamline> ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:used;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_prov_used_mono> ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate prov:used;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_prov_used_detector> ]
  ] .

# Four prov:used wrappers, one per instrument. Each is a blank-node
# entity with a single schema:instrument predicate joining to the
# instrument's TriplesMap.
<#TriplesMap_prov_used_beamline> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Beamline')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:template "_:prov_used_beamline"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:instrument;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_beamline> ]
  ] .

<#TriplesMap_prov_used_mono> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:template "_:prov_used_mono"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:instrument;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_mono> ]
  ] .

<#TriplesMap_prov_used_detector> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Detector')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:template "_:prov_used_detector"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:instrument;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_detector> ]
  ] .

# X-ray source (xasCore-required fourth peer). The XDI header typically
# doesn't carry distinct Source.* fields, so this emits static defaults
# suitable for the common case of a synchrotron X-ray source. If your
# XDI carries Source.type or Source.probe fields, add
# schema:additionalProperty entries that read them, mirroring the
# beamline/mono/detector pattern.
<#TriplesMap_prov_used_source> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:template "_:prov_used_source"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:instrument;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_source> ]
  ] .

<#TriplesMap_source> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Thing, schema:Product;
      rr:template "_:source_instrument"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:source ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "X-ray source" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_source_xraysourcetype> ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [ rr:parentTriplesMap <#TriplesMap_source_probe> ]
  ] .

<#TriplesMap_source_xraysourcetype> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:source_xraysourcetype"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:xraysourcetype ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "X-ray source type" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [ rr:constant "Synchrotron X-ray Source" ]
  ] .

<#TriplesMap_source_probe> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:source_probe"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:probe ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "Probe" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [ rr:constant "x-ray" ]
  ] .

<#TriplesMap_beamline> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Beamline')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Thing, schema:Product;
      rr:template "_:beamline"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:beamline ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:identifier;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Beamline_name']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "xas:Beamline/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Beamline_name']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "Beamline/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_beamline_collimation>
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_beamline_focusing>
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_beamline_harmonic_rejection>
    ]
  ] .

<#TriplesMap_beamline_collimation> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Beamline' && @['cdi:Beamline_collimation'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:beamline_collimation"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:collimation ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "collimation"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Beamline_collimation']['skos:definition']"
    ]
  ] .

