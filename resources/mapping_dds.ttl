    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "focusing"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Beamline_focusing']['skos:definition']"
    ]
  ] .

<#TriplesMap_beamline_harmonic_rejection> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Beamline' && @['cdi:Beamline_harmonic_rejection'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:beamline_harmonic_rejection"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:harmonicrejection ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "harmonic rejection"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Beamline_harmonic_rejection']['skos:definition']"
    ]
  ] .


<#TriplesMap_mono> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Thing, schema:Product;
      rr:template "_:mono"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:xraymonochromator ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:identifier;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Mono_name']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "xas:Mono/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Mono_name']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "Mono/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_mono_d_spacing>
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_mono_d_spacing_fallback>
    ]
  ] ;
  # xasCore requires the monochromator to carry THREE additionalProperty
  # entries: monochromatortype, dspacing (with unitText), reflectionplane.
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_mono_type>
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_mono_reflection>
    ]
  ] .

# Mono d_spacing PropertyValue. Split into two mutually-exclusive
# TriplesMaps so the schema:value is always emitted — either from the
# XDI Mono.d_spacing header (when present) or a placeholder "unknown"
# fallback (when absent). xasCore REQUIRES d_spacing to have a
# schema:value; without either TriplesMap firing, the mono would fail
# validation. If your XDI dialect uses a different key (e.g., 'crystal
# cut' + a lookup table from cut to d_spacing), extend the parse_xdi
# graph in api/cdi.py or add another synthesis step in generate_cdi.
<#TriplesMap_mono_d_spacing> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono' && @['cdi:Mono_d_spacing'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:mono_d_spacing"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "d-spacing"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:dspacing ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Mono_d_spacing']['skos:definition']"
    ]
  ] ;
  # xasCore requires unitText on d-spacing.
  rr:predicateObjectMap [
    rr:predicate schema:unitText;
    rr:objectMap [ rr:constant "Angstrom" ]
  ] .

# d_spacing fallback: fires when the XDI has no Mono.d_spacing header.
# Emits "unknown" as schema:value so the required predicate is present;
# the value is obviously a placeholder needing manual correction.
<#TriplesMap_mono_d_spacing_fallback> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono' && !@['cdi:Mono_d_spacing'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:mono_d_spacing"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "d-spacing" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:dspacing ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [ rr:constant "unknown" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:unitText;
    rr:objectMap [ rr:constant "Angstrom" ]
  ] .

# Crystal type property (xas:monochromatortype). Reads a Mono.type or
# Mono.crystal header if the XDI carries one (cdi:Mono_type), otherwise
# emits the string content from the same source. If the XDI carries no
# such header the value will be an empty string; consider emitting a
# hard fallback ("Si") once your XDI vocabulary is known.
<#TriplesMap_mono_type> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:mono_type"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "crystal type" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:monochromatortype ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [ rr:constant "Si" ]
  ] .

# Reflection plane property (xas:reflectionplane). Similar note as
# TriplesMap_mono_type: XDI headers rarely carry this explicitly, so
# emitted as a static default. Override with a real reflection ("1,1,1"
# for Si(111), "2,2,0" for Si(220), etc.) via rml:reference once your
# XDI vocabulary defines the field.
<#TriplesMap_mono_reflection> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Mono')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:mono_reflection"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [ rr:constant "reflection plane" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:reflectionplane ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:value;
    rr:objectMap [ rr:constant "1,1,1" ]
  ] .

<#TriplesMap_detector> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Detector')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Thing, schema:Product;
      rr:template "_:detector"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant xas:xraymonitor ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:identifier;
    rr:objectMap [
      rr:constant "xas:Detector"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "Detector" 
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_detector_i0>
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:additionalProperty;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_detector_i1>
    ]
  ] .

<#TriplesMap_detector_i0> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Detector' && @['cdi:Detector_I0'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:detector_i0"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:detectori0 ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "incident-flux detection method"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Detector_I0']['skos:definition']"
    ]
  ] .

<#TriplesMap_detector_i1> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Detector' && @['cdi:Detector_I1'])]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:PropertyValue;
      rr:template "_:detector_i1"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:propertyID;
    rr:objectMap [
      rr:constant xas:detectorit ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rr:constant "transmitted-flux detection method"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:value;
    rr:objectMap [
      rml:reference "$['cdi:Detector_I1']['skos:definition']"
    ]
  ] .

<#TriplesMap_dv_distribution_description> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:description;
    rr:objectMap [
      rml:reference "$['schema:description']"
    ]
  ] .

<#TriplesMap_dv_distribution_DataDownload> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:contentUrl;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:contentUrl']['@id']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:contentSize;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:contentSize']['@value']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:encodingFormat;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:encodingFormat']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate dcterms:conformsTo;
    rr:objectMap [
      rr:constant "https://github.com/XraySpectroscopy/XAS-Data-Interchange/blob/master/specification/spec.md" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:commentPrefix;
    rr:objectMap [
      rr:constant "#"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:arrayBase;
    rr:objectMap [
      rr:constant "1"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:hasHeader;
    rr:objectMap [
      rr:constant "true"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:skipInitialSpace;
    rr:objectMap [
      rr:constant "true"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:isDelimited;
    rr:objectMap [
      rr:constant "false"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:isFixedWidth;
    rr:objectMap [
      rr:constant "true"
    ]
  ] .

<#TriplesMap_dv_distribution_isStructuredBy> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:isStructuredBy;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_wideDataStructure>
    ]
  ] .

<#TriplesMap_wideDataStructure> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rml:class cdi:WideDataStructure;
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['@id']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "http://localhost:8080/citation?persistentId=perma:" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "https://example.org/struct/" ]
        ]
      ]
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdi:has_DataStructureComponent;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_components>
    ]
  ] .

<#TriplesMap_components> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['columns'][*]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
    rml:class cdi:MeasureComponent ;
    rml:reference "$['componentIRI']" ;
    rr:termType rr:IRI
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:isDefinedBy_RepresentedVariable ;
    rr:objectMap [
      rml:reference "$['rvIRI']" ;
      rr:termType rr:IRI
    ]
  ] .

<#TriplesMap_representedVariable> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['columns'][*]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
    rml:reference "$['rvIRI']" ;
    rr:termType rr:IRI
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/ .*$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] .

  <#TriplesMap_dv_distribution_hasPhysicalMapping> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][0]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate cdif:hasPhysicalMapping;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_physicalMapping>
    ]
  ] .

  <#TriplesMap_physicalMapping> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['columns'][*]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
    rr:termType rr:BlankNode;
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:index;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['columnKey']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/Column_/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdi:minimumLength;
    rr:objectMap [
      rr:constant 15
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdi:maximumLength;
    rr:objectMap [
      rr:constant 15
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:format;
    rr:objectMap [
      rr:constant "decimal"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:physicalDataType;
    rr:objectMap [
      rr:constant "decimal"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:formats_InstanceVariable;
    rr:objectMap [
      rml:reference "$['ivIRI']" ;
      rr:termType rr:IRI
    ]
  ] .