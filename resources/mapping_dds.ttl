@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix schema: <http://schema.org/> .
@prefix xas: <https://w3id.org/cdif/xas/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix cdi: <http://ddialliance.org/Specification/DDI-CDI/1.0/RDF/> .
@prefix cdif: <https://w3id.org/cdif/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix doi: <https://doi.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://example.org/> .

<#TriplesMap_root> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rml:class schema:Dataset;
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['@id']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "http://localhost:8080/citation?persistentId=perma:" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "https://example.org/dataset/" ]
        ]
      ]
    ];
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['schema:name']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:description;
    rr:objectMap [
      rml:reference "$['schema:description']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:url;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:contentUrl']['@id']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:sameAs;
    rr:objectMap [
      rml:reference "$['schema:distribution']['schema:description']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:license;
    rr:objectMap [
      rml:reference "$['schema:license']['@id']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:version;
    rr:objectMap [
      rml:reference "$['schema:version']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:keywords;
    rr:objectMap [
      rml:reference "$['schema:keywords']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:keywords;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_keywords_element_edge>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:keywords;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_keywords_element_symbol>
    ]
  ] ;
   rr:predicateObjectMap [ 
    rr:predicate  schema:identifier;
    rr:objectMap [ 
      rml:reference "$['schema:identifier']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:dateModified;
    rr:objectMap [ 
      rml:reference "$['schema:dateModified']['@value']"
    ]
  ] ;
   rr:predicateObjectMap [ 
    rr:predicate  schema:variableMeasured;
    rr:objectMap [ 
      rr:parentTriplesMap <#TriplesMap_variableMeasured>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:subjectOf;
    rr:objectMap [ 
      rr:parentTriplesMap <#TriplesMap_subjectOf>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	  rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_role_facility>
    ]
  ]  ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_author_role>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:contributor;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_dv_creator_role>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:measurementTechnique;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_panet>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:measurementTechnique;
	rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_nexus>
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  prov:wasGeneratedBy;
    rr:objectMap [
      rr:constant <https://w3id.org/cdif/xas/provevent>;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate  schema:distribution;
	  rr:objectMap [
	    rr:class schema:DataDownload, cdi:PhysicalDataSet, cdi:TabularTextDataSet;
      rr:template "_:dv_distribution"
    ]
  ] .
  
<#TriplesMap_variableMeasured> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['columns'][*]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ] ;
  rml:subjectMap [
    rml:class schema:PropertyValue, cdi:InstanceVariable ;
    rml:reference "$['ivIRI']" ;
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name ;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/ .*$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:alternateName;
     rr:objectMap [
      rml:reference "$['meaning']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:description;
     rr:objectMap [
      rml:reference "$['meaning']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cdif:uses;
     rr:objectMap [
      rml:reference "$['rvIRI']"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:propertyID;
    rr:objectMap [
      a fnml:FunctionTermMap;
      # Prepends the full XAS glossary base and marks the result as an
      # IRI reference so it serializes as JSON-LD {"@id": "..."} instead
      # of a bare string literal. Note: $['meaning'] values that carry
      # spaces or mixed case will produce non-resolving IRIs; the v2
      # glossary uses lowercase, no-underscore local names (see
      # https://w3id.org/cdif/xas/). Consider normalizing $['meaning']
      # upstream (in api/cdif.py's column build) so it lands here as a
      # v2-conformant local name.
      rr:termType rr:IRI ;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['meaning']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/^/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "https://w3id.org/cdif/xas/" ]
        ]
      ]
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:unitText ;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:controls_if ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:bool_b;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_contains ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['definition']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:string_sub;
                rr:objectMap [ rr:constant " " ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:any_true;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_replace ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['definition']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_find;
                rr:objectMap [ rr:constant "/^.* /" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_replace;
                rr:objectMap [ rr:constant "" ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:any_false;
          rr:objectMap [ rr:constant "" ]
        ]
      ]
    ]
  ] .

  
<#TriplesMap_subjectOf> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] =~ /^http:\\/\\/localhost:8080\\/citation\\?persistentId=perma:DV\\/.*/)]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ] ;
  rml:subjectMap [
      rml:class schema:Dataset;
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [
            a fnml:FunctionTermMap;
            fnml:functionValue [
              rr:predicateObjectMap [
                rr:predicate fno:executes;
                rr:objectMap [ rr:constant grel:string_replace ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:valueParameter;
                rr:objectMap [ rml:reference "$['@id']" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_find;
                rr:objectMap [ rr:constant "http://localhost:8080/citation?persistentId=perma:" ]
              ];
              rr:predicateObjectMap [
                rr:predicate grel:p_string_replace;
                rr:objectMap [ rr:constant "https://example.org/dataset/" ]
              ]
            ]
          ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "/metadata" ]
        ]
      ]
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:additionalType;
    rr:objectMap [
      rr:constant dcat:CatalogRecord ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/core/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/discovery/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/data_description/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/data_structure/1.1> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/xasCore/1.0> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
        rr:predicate dcterms:conformsTo ;
        rr:objectMap [
            rr:constant <https://w3id.org/cdif/xasOptional/1.0> ;
            rr:termType rr:IRI
        ]
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:about;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_root>;
      rr:joinCondition [
        rr:child "$['@id']";
        rr:parent "$['@id']"
      ]
    ]
  ] .
 

<#TriplesMap_role_facility> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Facility')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Role;
      rml:template "_:role_facility"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:roleName;
    rr:objectMap [
      rr:constant "Facility"
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate schema:contributor;
    rr:objectMap [
      rr:parentTriplesMap <#TriplesMap_role_facility_name>
    ]
  ] .

<#TriplesMap_role_facility_name> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Facility')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:Organization;
      rml:template "_:role_facility_name"
    ] ;
  rr:predicateObjectMap [
    rr:predicate schema:name;
    rr:objectMap [
      rml:reference "$['cdi:Facility_name']['skos:definition']"
    ]
  ] .

<#TriplesMap_keywords_element_edge> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Element')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rml:template "_:keywords_element_edge"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:termCode;
    rr:objectMap [
      rml:reference "$['cdi:Element_edge']['skos:definition']"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:inDefinedTermSet;
    rr:objectMap [
      rr:constant "https://github.com/XraySpectroscopy/XAS-Data-Interchange/blob/master/specification/dictionary.md"
    ]
  ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:name;
    rr:objectMap [
      a fnml:FunctionTermMap;
      fnml:functionValue [
        rr:predicateObjectMap [
          rr:predicate fno:executes;
          rr:objectMap [ rr:constant grel:string_replace ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:valueParameter;
          rr:objectMap [ rml:reference "$['cdi:Element_edge']['skos:definition']" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_find;
          rr:objectMap [ rr:constant "/$/" ]
        ];
        rr:predicateObjectMap [
          rr:predicate grel:p_string_replace;
          rr:objectMap [ rr:constant "-edge" ]
        ]
      ]
    ]
  ] .

<#TriplesMap_keywords_element_symbol> a rml:TriplesMap;
  rml:logicalSource [ a rml:LogicalSource;
      rml:iterator "$['@graph'][?(@['@id'] == 'cdi:Element')]";
      rml:referenceFormulation rml:JSONPath;
      rml:source [ a rml:RelativePathSource;
          rml:root rml:MappingDirectory;
          rml:path "cdif_skos.json"
        ]
    ];
  rml:subjectMap [
      rr:termType rr:BlankNode;
      rr:class schema:DefinedTerm;
      rml:template "_:keywords_element_symbol"
    ] ;
  rr:predicateObjectMap [ 
    rr:predicate schema:termCode;
    rr:objectMap [
      rml:reference "$['cdi:Element_symbol']['skos:definition']"
    ]
  ] .

